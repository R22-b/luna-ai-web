# Works with ZERO keys via Pollinations fallback!
# Add keys progressively for better quality.

# ═══ CORE AI (Start with these) ═══
GROQ_API_KEY=                    # free: console.groq.com
GEMINI_API_KEY=                  # free: aistudio.google.com

# ═══ EXTENDED AI PROVIDERS ═══
OPENROUTER_API_KEY=              # free: openrouter.ai
NVIDIA_API_KEY=                  # free: build.nvidia.com
COHERE_API_KEY=                  # free: dashboard.cohere.com
MISTRAL_API_KEY=                 # free: console.mistral.ai
TOGETHER_API_KEY=                # free: api.together.xyz
HF_API_KEY=                      # free: huggingface.co/settings/tokens
DEEPSEEK_API_KEY=                # free: platform.deepseek.com
CEREBRAS_API_KEY=                # free: cloud.cerebras.ai
SAMBANOVA_API_KEY=               # free: cloud.sambanova.ai
XAI_API_KEY=                     # free: console.x.ai
MOONSHOT_API_KEY=                # free: platform.moonshot.cn
FIREWORKS_API_KEY=               # free: fireworks.ai
AI21_API_KEY=                    # free: studio.ai21.com
QWEN_API_KEY=                    # free: dashscope.aliyuncs.com
PERPLEXITY_API_KEY=              # free: perplexity.ai/settings/api

# ═══ IMAGE GENERATION ═══
LEONARDO_API_KEY=                # free: app.leonardo.ai (150 credits/day)
# Pollinations = NO KEY NEEDED — always works!

# ═══ SEARCH (for Research feature) ═══
SERPER_API_KEY=                  # free: serper.dev (2500 searches)
BRAVE_API_KEY=                   # free: brave.com/search/api

# ═══ SERVER ═══
PORT=3001
FRONTEND_URL=http://localhost:5173
NODE_ENV=development
